# ═══════════════════════════════════════════════════════════════════
#  NEXUS AI-NATIVE OS — Environment Configuration Template
#  Copy this file: cp .env.example .env
#  Fill in ALL required values before starting the server.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── System ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com

# Admin secret — generate with: openssl rand -hex 32
OWNER_SECRET=your-super-secret-admin-key-min-32-chars

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-key-min-64-chars

# ── Firebase (Required for Firestore + Auth) ─────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Escape newlines: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Database Provider ────────────────────────────────────────────────
# Options: firestore | postgres | supabase | mongodb | memory
DB_PROVIDER=firestore

# PostgreSQL (if DB_PROVIDER=postgres)
# POSTGRES_URL=postgresql://user:password@host:5432/nexusdb
# POSTGRES_POOL_SIZE=10

# Supabase (if DB_PROVIDER=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB (if DB_PROVIDER=mongodb)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexusdb

# ── Redis (Optional but recommended for production) ──────────────────
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@your-redis-host:6379
REDIS_TTL_SHORT=300
REDIS_TTL_LONG=86400

# ── AI Providers — add at least ONE ─────────────────────────────────
# Free tier — start here
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Premium providers (optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MISTRAL_API_KEY=your-mistral-api-key

# Alternative routing providers (optional)
OPENROUTER_API_KEY=your-openrouter-api-key
TOGETHER_API_KEY=your-together-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
FIREWORKS_API_KEY=your-fireworks-api-key

# Local AI (optional)
ENABLE_LOCAL_AI=false
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_BASE_URL=
LITELLM_API_KEY=

# AI limits
DEFAULT_AI_MODEL=gemini-flash
MAX_TOKENS_PER_DAY=1000000

# ── Payments ─────────────────────────────────────────────────────────
# Stripe (International cards)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# bKash (Bangladesh mobile banking)
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad (Bangladesh)
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_MERCHANT_PRIVATE_KEY=your-nagad-private-key
NAGAD_MERCHANT_PUBLIC_KEY=your-nagad-public-key
NAGAD_BASE_URL=https://api.mynagad.com
# Sandbox: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# Rocket / Dutch-Bangla (Bangladesh)
ROCKET_USERNAME=your-rocket-username
ROCKET_PASSWORD=your-rocket-password
ROCKET_MERCHANT_ID=your-rocket-merchant-id
ROCKET_BASE_URL=https://rocket.com.bd/mpg

# ── Omnichannel Messaging ─────────────────────────────────────────────
# WhatsApp Business API
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Facebook / Instagram
FACEBOOK_PAGE_TOKEN=your-facebook-page-token
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# TikTok
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# ── Notifications ────────────────────────────────────────────────────
# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# ── Storage ──────────────────────────────────────────────────────────
# Firebase Storage bucket (usually auto from firebase config)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Monitoring (Optional) ─────────────────────────────────────────────
# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Feature Flags ────────────────────────────────────────────────────
ENABLE_VECTOR_MEMORY=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Security ─────────────────────────────────────────────────────────
# CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session
SESSION_SECRET=your-session-secret-min-32-chars

# ── Delivery / Logistics ─────────────────────────────────────────────
# Google Maps API (for route optimization)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── Business ─────────────────────────────────────────────────────────
BUSINESS_NAME=NexusOS
BUSINESS_CURRENCY=BDT
BUSINESS_TIMEZONE=Asia/Dhaka
DEFAULT_DELIVERY_RADIUS_KM=10

# ── Development only ─────────────────────────────────────────────────
# Set to true to disable HMR in development (useful for some environments)
# DISABLE_HMR=false
