{
  "name": "nexusos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/validate-env.js; tsx server.ts",
    "start": "NODE_ENV=production node scripts/validate-env.js && tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "validate:env": "node scripts/validate-env.js",
    "lint": "tsc --noEmit",
    "lint:server": "tsc --noEmit -p tsconfig.server.json",
    "lint:all": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "setup": "cp .env.example .env && echo \"\u2705 .env created \u2014 fill in your API keys\"",
    "setup:check": "node scripts/validate-env.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src server.ts --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src server.ts --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture/dependency-graph.svg"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "firebase": "^12.11.0",
    "fuse.js": "^7.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "stripe": "^21.0.1",
    "three": "^0.183.2",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6",
    "vite-plugin-pwa": "^1.0.0",
    "firebase-admin": "^12.3.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.8.1",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^11.9.1",
    "@sentry/node": "^8.55.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io-client": "^4.8.1",
    "@mlc-ai/web-llm": "^0.2.82",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.4",
    "@supabase/supabase-js": "^2.45.4",
    "mongodb": "^6.10.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/speakeasy": "^2.0.9",
    "@types/qrcode": "^1.5.5",
    "@types/pg": "^8.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "dependency-cruiser": "^16.10.0",
    "vitest": "^3.0.5",
    "zustand": "^4.5.2"
  },
  "nexusInstallNote": "Run: npm install --ignore-scripts if native module compilation fails. DB defaults to in-memory if sqlite/turso optional deps are not available.",
  "description": "NexusOS \u2014 AI-Native Business Operating System",
  "author": "NexusOS Engineering",
  "license": "UNLICENSED"
}